generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id       Int        @id @default(autoincrement())
  name     String
  Location Location[]
}

model Image {
  id       Int        @id @default(autoincrement())
  name     String
  Location Location[]
  Score    Score[]
}

model Location {
  id        Int       @id @default(autoincrement())
  charId    Int
  imageId   Int
  latitude  Float
  longitude Float
  Character Character @relation(fields: [charId], references: [id])
  Image     Image     @relation(fields: [imageId], references: [id])
}

model Score {
  id          Int       @id @default(autoincrement())
  time        Float?
  name        String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  imageId     Int
  Image       Image     @relation(fields: [imageId], references: [id])
}
